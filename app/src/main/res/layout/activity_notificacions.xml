<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fons_suau"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_targeta"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/botoEnrere"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fons_capsula"
            android:contentDescription="@string/boto_enrere"
            android:padding="8dp"
            android:src="@drawable/ic_enrere"
            app:tint="@color/color_text_principal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/notificacions_titol"
            android:textColor="@color/color_text_principal"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/botoMarcarTotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/notificacions_marcar_totes"
            android:textColor="@color/color_principal"
            android:textSize="13sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/barraAccionsNotificacions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_targeta"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSeleccioNotificacions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:textColor="@color/color_text_secundari"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/botoSeleccionarTotes"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/notificacions_seleccionar_totes"
                android:textColor="@color/color_principal"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/botoMarcarLlegides"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/notificacions_marcar_llegides"
                android:textColor="@color/color_principal"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/botoMarcarNoLlegides"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/notificacions_marcar_no_llegides"
                android:textColor="@color/color_principal"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/botoEliminarSeleccionades"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/notificacions_eliminar"
                android:textColor="@color/color_error"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/botoCancelarSeleccio"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/notificacions_cancelar"
                android:textColor="@color/color_text_secundari"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/llistaNotificacions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/txtBuit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/notificacions_buit"
        android:textColor="@color/color_text_secundari"
        android:visibility="gone" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
