<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fons_pantalla"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/botoEnrere"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fons_capsula"
                android:contentDescription="@string/boto_enrere"
                android:padding="10dp"
                android:src="@drawable/ic_enrere"
                app:tint="@color/color_principal" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/perfil_titol"
                android:textColor="@color/color_text_principal"
                android:textSize="23sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botoEditarPerfil"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/boto_editar_perfil"
                android:textColor="@color/color_principal"
                android:textSize="13sp"
                app:cornerRadius="19dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="@color/color_principal"
                app:strokeColor="@color/color_principal"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/color_targeta"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_linia"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp">

                <FrameLayout
                    android:layout_width="106dp"
                    android:layout_height="106dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imatgePerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/FormaAvatarCercle" />

                    <TextView
                        android:id="@+id/txtInicialAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/fons_avatar"
                        android:gravity="center"
                        android:text="V"
                        android:textColor="@color/color_text_clar"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iconaVerificat"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/fons_badge"
                        android:padding="2dp"
                        android:src="@drawable/ic_verified"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtNom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/color_text_principal"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RatingBar
                        android:id="@+id/barraReputacio"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:progressTint="#D49319"
                        android:stepSize="0.1" />

                    <TextView
                        android:id="@+id/txtTotalValoracions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/color_text_secundari"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/color_text_secundari"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botoProxims"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/fons_boto_principal"
                android:text="@string/perfil_proxims"
                android:textAllCaps="false"
                android:textColor="@color/color_text_clar"
                app:backgroundTint="@null"
                app:cornerRadius="8dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botoPassats"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/perfil_passats"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:strokeColor="@color/color_principal" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/llistaReserves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/txtBuit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/perfil_cap_element"
            android:textColor="@color/color_text_secundari"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoCanviarContrasenya"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="@string/boto_he_oblidat"
            android:textColor="@color/color_principal"
            app:cornerRadius="8dp"
            app:strokeColor="@color/color_principal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoTancarSessio"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/boto_tancar_sessio"
            android:textColor="@color/color_error" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
