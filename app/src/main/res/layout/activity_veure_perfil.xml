<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fons_pantalla"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingTop="40dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/botoEnrere"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="start"
                android:background="@drawable/fons_capsula"
                android:contentDescription="@string/boto_enrere"
                android:padding="10dp"
                android:src="@drawable/ic_enrere"
                app:tint="@color/color_text_fosc" />

            <TextView
                android:id="@+id/txtTitolPerfil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/text_usuari"
                android:textColor="@color/color_text_principal"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fons_targeta"
            android:elevation="0dp"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imatgePerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/FormaAvatarCercle" />

                <TextView
                    android:id="@+id/txtInicialAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/fons_avatar"
                    android:gravity="center"
                    android:text="V"
                    android:textColor="@color/color_text_clar"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtNom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/color_text_principal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/barraReputacio"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="#FFD700"
                    android:stepSize="0.1" />

                <TextView
                    android:id="@+id/txtValoracio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/color_text_secundari"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoSeguir"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="14dp"
            android:text="@string/boto_seguir_usuari"
            android:textColor="@color/color_principal"
            app:cornerRadius="8dp"
            app:strokeColor="@color/color_principal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoVeureTrajectes"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/fons_boto_principal"
            android:text="@string/boto_veure_trajectes_usuari"
            android:textColor="@color/color_text_clar"
            app:backgroundTint="@null"
            app:cornerRadius="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botoSeccioSobreMi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/fons_boto_principal"
                android:text="@string/perfil_sobre_mi"
                android:textColor="@color/color_text_clar"
                app:backgroundTint="@null" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botoSeccioComentaris"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/perfil_comentaris"
                android:textColor="@color/color_text_principal"
                app:strokeColor="@color/color_text_principal"
                app:strokeWidth="2dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/seccioSobreMi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fons_targeta"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_sobre_mi"
                    android:textColor="@color/color_text_principal"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/color_text_secundari"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/seccioComentaris"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fons_targeta"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_comentaris_titol"
                    android:textColor="@color/color_text_principal"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/llistaComentaris"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/txtBuitComentaris"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/perfil_comentaris_buit"
                    android:textColor="@color/color_text_secundari"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoObrirXat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fons_boto_principal"
            android:text="@string/boto_obrir_xat"
            android:textColor="@color/color_text_clar"
            android:visibility="gone"
            app:backgroundTint="@null"
            app:cornerRadius="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
