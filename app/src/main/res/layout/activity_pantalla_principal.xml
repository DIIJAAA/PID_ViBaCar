<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fons_pantalla">

    <LinearLayout
        android:id="@+id/capcalera"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSalutacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_principal"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/principal_subtitol"
                android:textColor="@color/color_text_secundari" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/botoPerfil"
            android:layout_width="54dp"
            android:layout_height="54dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imatgePerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/FormaAvatarCercle" />

            <TextView
                android:id="@+id/txtInicialAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fons_avatar"
                android:gravity="center"
                android:text="V"
                android:textColor="@color/color_text_clar"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCerca"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:hint="@string/principal_cerca_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/capcalera"
        app:startIconDrawable="@android:drawable/ic_menu_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/campCerca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/llistaViatges"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCerca" />

    <TextView
        android:id="@+id/txtBuit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:gravity="center"
        android:text="@string/principal_buit"
        android:textColor="@color/color_text_secundari"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/llistaViatges"
        app:layout_constraintEnd_toEndOf="@id/llistaViatges"
        app:layout_constraintStart_toStartOf="@id/llistaViatges"
        app:layout_constraintTop_toTopOf="@id/llistaViatges" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botoCrearViatge"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/fons_boto_principal"
        android:text="@string/boto_crear_viatge"
        android:textColor="@color/color_text_clar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
