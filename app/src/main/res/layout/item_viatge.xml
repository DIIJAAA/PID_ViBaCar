<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/color_targeta"
    app:cardCornerRadius="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imatgeConductor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/FormaAvatarCercle" />

                <TextView
                    android:id="@+id/txtInicialConductor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/fons_avatar"
                    android:gravity="center"
                    android:text="V"
                    android:textColor="@color/color_text_clar"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNomConductor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_principal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtValoracio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secundari" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPreu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fons_xip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColor="@color/color_exit"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/color_text_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHoraris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/color_text_secundari" />

        <TextView
            android:id="@+id/txtPlaces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_text_secundari" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
